# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# From @BotFather on Telegram after creating the bot
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id — the bot ignores everyone else.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_ID=

# A shared secret that proves a webhook request really came from Telegram.
# The endpoint URL and your numeric id are both discoverable, so without this
# anyone who knows them can forge messages that spawn a real agent turn.
# Telegram sends this value in the X-Telegram-Bot-Api-Secret-Token header on
# every genuine delivery, and the webhook rejects anything that doesn't match.
# Allowed characters: A-Z a-z 0-9 _ - (1-256). Generate a random value, e.g.
# in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# Set it here, then run scripts/set_webhook.py to register it with Telegram.
TELEGRAM_WEBHOOK_SECRET=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model slug OpenRouter serves, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Fine-grained personal access token, scoped to ONLY the sudarshana repo, with
# Contents: Read and write + Pull requests: Read and write.
# Create at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Your own email address — the ONLY account allowed to use the /control panel
# (control-api forward-auths the Netlify Identity JWT and allowlists this).
# Must match the email that accepted the Netlify Identity invite.
CONTROL_OWNER_EMAIL=

# Credential broker (credential-broker/): its URL, printed by `modal deploy`,
# and a Modal proxy token from `modal workspace proxy-tokens create`. The agent's
# tools read these; the shell never gets the token.
BROKER_URL=
BROKER_TOKEN_ID=
BROKER_TOKEN_SECRET=

# --- Server runtime only (src/sudarshana/infra/runtime/server) ---------------
# Not used by the Modal app. The server runs the agent on one ordinary machine.
#
# Password for the web chat page (/chat). Required when CHANNEL=webchat; there
# is no default. Any username in the browser's prompt, only this is checked.
WEBCHAT_PASSWORD=
# webchat (a page at /chat; the default) or telegram (POST /telegram, for a
# test bot's webhook; never production's bot).
CHANNEL=webchat
# 1 = run the hourly turn too; unset or 0 = only reply to messages.
HOURLY=0
# The workspace folder, /data if unset. Set it in the environment too if you
# use start.sh, which reads it for the log path.
# SUDARSHANA_DATA=/data
# PORT=8000
