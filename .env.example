# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# From @BotFather on Telegram after creating the bot
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id — the bot ignores everyone else.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_ID=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model slug OpenRouter serves, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
